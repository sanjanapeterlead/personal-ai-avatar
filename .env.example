# LLM provider: ollama | gemini
LLM_PROVIDER=gemini

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Gemini — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Avatar owner (shown in UI and escalation emails)
AVATAR_OWNER_NAME=Your Name
AVATAR_OWNER_EMAIL=your@email.com
AVATAR_OWNER_WHATSAPP=

# Slack escalation (optional) — Incoming Webhook URL for real-time notifications
# when the avatar can't answer a question. Create one at:
# https://api.slack.com/messaging/webhooks
# Leave blank to disable — the app works fine without it.
SLACK_WEBHOOK_URL=
